{
  "name": "subakeerthii-portfolio-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend/website",
    "frontend/admin",
    "backend"
  ],
  "scripts": {
    "dev:website": "npm run dev --workspace=frontend/website",
    "dev:admin": "npm run dev --workspace=frontend/admin",
    "dev:backend": "npm run dev --workspace=backend",
    "build:website": "npm run build --workspace=frontend/website",
    "build:admin": "npm run build --workspace=frontend/admin",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build:backend && npm run build:website && npm run build:admin",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
